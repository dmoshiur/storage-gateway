# Public Firebase Web SDK configuration. These identifiers are safe to expose,
# but use a separate Firebase project for development/preview/production.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:replace-me
# Optional, if enabled in your Firebase project.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789

# Firebase Admin SDK — server only. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Preserve escaped newlines when adding this in Vercel.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# Comma-separated bootstrap administrators. Prefer Firebase custom claims in production.
ADMIN_EMAILS=admin@example.org
# Required shared administrator passphrase (8+ characters). Signing in with it
# grants FULL administrator access with no Firebase account, so keep it long and
# secret; never prefix with NEXT_PUBLIC_. Rotating it invalidates every
# shared-passphrase session.
ADMIN_PASS=replace-with-a-long-admin-passphrase

# Private Cloudflare R2 bucket — server only.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=am-storage-company-development
# Example: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# High-entropy server-to-server secret shared with the AM Storage Bridge
# (FastAPI) and used for internal bridge calls and the NGO website integration.
# Send it as X-Storage-Gateway-Key from servers only, never from a browser.
INTEGRATION_API_KEY=generate-a-long-random-secret

# Optional 32-byte base64 master key (generate with:
#   openssl rand -base64 32)
# Enables HMAC *signed* API mode: dashboard-generated API secrets are stored
# encrypted (AES-256-GCM) so the bridge can verify
# X-AM-Storage-Signature + X-AM-Storage-Timestamp requests without ever
# receiving the raw secret. Without it, the dual-token headers
# (X-AM-Storage-Key-Id + X-AM-Storage-Key-Secret) still work and signed mode
# reports as unavailable.
AM_STORAGE_MASTER_KEY=

# High-entropy secret Vercel Cron sends as: Authorization: Bearer <secret>
CRON_SECRET=generate-a-different-long-random-secret

# Used for links and same-origin checks. Set independently per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Embedded Storage Bridge — runs in this SAME Vercel deployment (no separate
# bridge server needed). gramunnayan.com calls POST /api/v1/storage/upload on
# this app's own URL with its dual-token API credential. Supported document
# types: PDF, DOC, DOCX, TXT, PPT, PPTX.
# ---------------------------------------------------------------------------
# Optional comma-separated static keys accepted without a registry round-trip
# (self-hosted/offline mode). Dashboard-managed keys are always verified
# against the Firestore registry.
# AM_STORAGE_KEYS=static-key-one,static-key-two
# Hard per-file cap for bridge uploads in bytes. The effective limit is the
# minimum of this value and the dashboard's maxPdfSizeBytes setting.
# AM_STORAGE_MAX_DOCUMENT_BYTES=52428800
# Legacy alias for the above; still accepted for existing deployments.
# AM_STORAGE_MAX_PDF_BYTES=52428800
# Lifetime in seconds (60-86400) of signed document URLs returned to the NGO
# site by bridge uploads.
# AM_STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600
# Browser origins allowed to call the bridge. Server-to-server calls from the
# gramunnayan.com backend are unaffected by this list.
# CORS_ORIGINS=https://gramunnayan.com,https://www.gramunnayan.com

# Optional legacy overrides. The dashboard snippets and health probe default to
# this deployment's own origin (NEXT_PUBLIC_APP_URL). Only set these if you run
# the historical standalone FastAPI bridge on another host (see fastapi/).
# NEXT_PUBLIC_BRIDGE_URL=https://bridge.your-domain.example
# BRIDGE_URL=https://bridge.your-domain.example

# ---------------------------------------------------------------------------
# Standalone FastAPI bridge (OPTIONAL legacy) — configure ONLY on that bridge
# host, never on Vercel. The embedded bridge above makes this unnecessary for
# new deployments. See fastapi/README.md.
# ---------------------------------------------------------------------------
# STORAGE_GATEWAY_URL=http://localhost:3000
