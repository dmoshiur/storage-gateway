# First-party backend configuration
# Turso (libSQL) is required for all users, sessions, metadata, API keys, audit
# data, retention rules, notifications, and system settings.
# Local development can use a file database: TURSO_DATABASE_URL=file:./local.db
TURSO_DATABASE_URL=libsql://am-cloud-api-am-moshiur.aws-us-east-1.turso.io
# Create with: turso db tokens create am-cloud-api-am-moshiur
TURSO_AUTH_TOKEN=replace-with-a-turso-database-token
# Alternative names accepted by the app and migration script (libsql:// or file: URL):
# DATABASE_URL=libsql://am-cloud-api-am-moshiur.aws-us-east-1.turso.io

# Optional bootstrap administrator. `npm run db:migrate` creates this user once
# when both values are present. Use a long unique password, then remove these
# variables after the first deployment.
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Vercel Private Blob (server-only; never expose these to the browser).
#
# On Vercel, connecting a private Blob store to this project is enough: Vercel
# injects BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY, and the runtime hands the
# function a short-lived OIDC token per request (`x-vercel-oidc-token`), which
# the Blob SDK picks up automatically.
#   BLOB_STORE_ID=store_replace-me
#   BLOB_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
#
# VERCEL_OIDC_TOKEN is NOT a stored Vercel variable and must not be created
# manually — only `vercel env pull` writes it to a local .env for `npm run dev`.
#
# A static read-write token is an optional fallback for stores that still issue
# long-lived credentials (or for local development against a real store).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-me

# Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=generate-a-different-long-random-secret

# Canonical URL used for secure origin checks and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional limits and integration settings.
# MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
# API_RATE_LIMIT_PER_MINUTE=120
# API_RATE_LIMIT_BURST=30
# CORS_ORIGINS=https://your-trusted-server.example

# The embedded /api/v1 API accepts dashboard-generated bearer API keys.
# API keys are hashed with SHA-256 and raw secrets are never persisted.
# API key scopes are managed in the admin API screen.
