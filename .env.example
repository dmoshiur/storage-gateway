# First-party backend configuration
# PostgreSQL is required for all users, sessions, metadata, API keys, audit data,
# retention rules, notifications, and system settings.
DATABASE_URL=postgresql://storage_gateway:change-me@localhost:5432/storage_gateway
# Optional separate admin URL for migrations. Defaults to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://storage_gateway:change-me@localhost:5432/storage_gateway

# Optional bootstrap administrator. `npm run db:migrate` creates this user once
# when both values are present. Use a long unique password, then remove these
# variables after the first deployment.
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Vercel Private Blob. The Blob store must be private; this token is server-only.
# Vercel injects BLOB_READ_WRITE_TOKEN when a Blob integration is attached.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-me
# For Vercel OIDC deployments, set BLOB_STORE_ID and VERCEL_OIDC_TOKEN instead.
# BLOB_STORE_ID=store_replace-me
# VERCEL_OIDC_TOKEN=replace-me

# Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=generate-a-different-long-random-secret

# Canonical URL used for secure origin checks and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional limits and integration settings.
# MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
# API_RATE_LIMIT_PER_MINUTE=120
# API_RATE_LIMIT_BURST=30
# CORS_ORIGINS=https://your-trusted-server.example

# The embedded /api/v1 API accepts dashboard-generated bearer API keys.
# API keys are hashed with SHA-256 and raw secrets are never persisted.
# API key scopes are managed in the admin API screen.
