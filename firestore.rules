rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Roles are set only with Firebase Admin SDK / Firebase Auth custom claims.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // The application uses the Admin SDK for all writes. These rules provide
    // read-only, role-gated access if an admin uses a Firebase client directly.
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /files/{fileId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
