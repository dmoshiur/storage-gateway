rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor');
    }

    function isViewer() {
      return hasRole('viewer');
    }

    function canReadFiles() {
      return isAdmin() || isEditor() || isViewer();
    }

    // The application uses the Admin SDK for all reads/writes via API routes.
    // These rules provide defense-in-depth for direct client access:
    // - Users can read their own profile.
    // - Admins can read all collections; editors/viewers can read files for direct SDK usage.
    // - No client writes are allowed — all mutations go through Admin SDK with server-side authz.
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /files/{fileId} {
      allow read: if canReadFiles();
      allow create, update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if canReadFiles();
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || isEditor() || isViewer();
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /v1ApiKeys/{keyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /apiKeys/{keyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /webhooks/{webhookId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
